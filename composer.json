{
    "name": "myerscode/acorn",
    "description": "A framework for creating powerful PHP CLI applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fred Myerscough",
            "email": "oniice@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "acorn"
    ],
    "require": {
        "php": "^8.5",
        "myerscode/acorn-framework": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "myerscode/acorn-cli": "dev-main",
        "myerscode/acorn-testing": "dev-main",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "tests": "vendor/bin/phpunit --testdox --no-coverage --colors=always",
        "test-coverage": "vendor/bin/phpunit --testdox --colors=always",
        "security-audit": "@composer audit"
    }
}
