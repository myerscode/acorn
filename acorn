#!/usr/bin/env php
<?php

use Myerscode\Acorn\Kernel;

define('ACORN_START', microtime(true));

if (file_exists(__DIR__.'/vendor/autoload.php')) {
    require __DIR__.'/vendor/autoload.php';
} elseif (file_exists(__DIR__.'/../../autoload.php')) {
    // might be installed globally
    require __DIR__.'/../../autoload.php';
} else {
    throw new Exception('Unable to locate vendor autoload.php');
}

$defaultBasePath = __DIR__ . '/app';

// Allow APP_BASE_PATH to relocate the app directory, but validate it: it must
// resolve to an existing, readable directory. An unset or invalid value falls
// back to the default rather than handing an arbitrary path to discovery.
$basePath = $defaultBasePath;

if (isset($_ENV['APP_BASE_PATH']) && is_string($_ENV['APP_BASE_PATH']) && $_ENV['APP_BASE_PATH'] !== '') {
    $resolved = realpath($_ENV['APP_BASE_PATH']);

    if ($resolved !== false && is_dir($resolved)) {
        $basePath = $resolved;
    } else {
        fwrite(STDERR, sprintf('Warning: APP_BASE_PATH "%s" is not a readable directory; using %s' . PHP_EOL, $_ENV['APP_BASE_PATH'], $defaultBasePath));
    }
}

$application = new Kernel($basePath);

exit($application->run());
